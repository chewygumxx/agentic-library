// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/agentic-library.git
// ::: :/.knip.jsonc
//
//

// https://knip.dev/reference/configuration
//
// knip finds the entry files by itself; this file lists only what it cannot
// see. Files are globs; dependencies and binaries, regular expressions.
{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    "workspaces": {
        ".": {
            // `bun test` finds these by name, which knip does not follow.
            "entry": ["tests/**/*.test.mts"]
        },
        // Run by mise tasks and agents, by their paths.
        "skills/authoring-agent-skills": {
            "entry": ["scripts/*.mjs"]
        },
        "skills/publishing-skills-to-npm": {
            "entry": ["scripts/skill-packages.mjs"]
        }
    },
    // A skill's assets are copied out to other repositories, never run here;
    // a vendored bundle exports what its library does, used or not.
    "ignore": ["skills/*/assets/**", "skills/*/scripts/vendor/**"],
    "ignoreDependencies": [
        // The shared configurations, named by path in the mise tasks,
        // by `extends` or `import`, or from `.secretlintrc.json`.
        "@chewygumxx/.+",
        // Extended by @chewygumxx/commitlint-config, which depends on them.
        "@commitlint/config-conventional",
        "conventional-changelog-conventionalcommits",
        // Run by the mise tasks, which knip does not read.
        "@biomejs/biome",
        "cspell",
        "publint",
        "secretlint",
        "sort-package-json",
        "sync-header-metadata"
    ],
    // The tool manager, which `package.json` runs for its `check`; and
    // bubblewrap, which run-eval.mjs jails each evaluation run in.
    "ignoreBinaries": ["mise", "bwrap"],
    // Configured under `.config/`, where neither tool looks unless the mise
    // tasks pass the path.
    "prettier": {
        "config": [".config/prettierrc.json"]
    },
    "remark": {
        "config": [".config/remarkrc.json"]
    }
}
