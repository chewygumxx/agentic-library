//
// Copied to .config/hk.pkl, its own path above changed to match.
//

amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

import "../node_modules/@chewygumxx/hk-config/steps.pkl" as shared

// Steps also rerun when these change, such as a repository's own copies of
// the configuration packages.
local cgxx = (shared) {
    extraInputs = List()
}

hooks {
    ["check"] {
        steps = cgxx.lint
    }
    ["fix"] {
        stage = false
        steps = cgxx.format
    }
    ["pre-commit"] {
        stash = "git"
        fix = false
        stage = false
        steps {
            ["check"] {
                check = "mise run check --staged"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "mise run lint:commit \"{{ commit_msg_file }}\""
            }
        }
    }
}
