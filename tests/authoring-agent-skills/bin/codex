# A stand-in for `codex exec --json`, for run-eval.mjs's tests: reads the
# skill when $STUB_MODE is use, and writes a skill to its workspace.

skill=${STUB_SKILL:-processing-things}
mkdir -p skills/made && printf -- '---\nname: made\ndescription: Makes things. Use when needed.\n---\n' >skills/made/SKILL.md
if [ "${STUB_MODE:-use}" = use ]; then
    printf '%s\n' "{\"type\":\"item.completed\",\"item\":{\"type\":\"command_execution\",\"command\":\"cat .agents/skills/$skill/SKILL.md\"}}"
fi
printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":200,"output_tokens":30}}'
printf '%s\n' '{"type":"item.completed","item":{"type":"agent_message","text":"Done."}}'
